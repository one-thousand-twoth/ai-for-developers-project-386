{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": "src/generated",
    "outDir": "dist",
    "types": []
  },
  "include": ["src/generated/**/*.ts"]
}
